<jaxb:bindings
	xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
	jaxb:version="3.0"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc"
>
	<jaxb:globalBindings >
		<xjc:javaType name="java.time.LocalDate"
					  xmlType="xs:date"
					  adapter="ch.dvbern.ebegu.ws.converters.LocalDateAdapter"
		/>
		<xjc:javaType name="java.time.LocalDateTime"
					  xmlType="xs:dateTime"
					  adapter="ch.dvbern.ebegu.ws.converters.LocalDateTimeUTCConverter"
		/>
		<jaxb:serializable uid="7702"/>
	</jaxb:globalBindings>

</jaxb:bindings>
