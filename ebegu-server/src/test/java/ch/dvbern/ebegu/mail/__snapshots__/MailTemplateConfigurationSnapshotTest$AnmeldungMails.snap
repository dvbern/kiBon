InfoSchulamtAnmeldungAbgelehnt[BERN_FRANZOESISCH]=[
From: kibon@dvbern.ch
To: Dagmar Wälti <empfaenger@dvbern.ch>
Subject: 000042, 2017/2018, kiBon  – Rejet de l'inscription
Content-Type: text/html;charset=utf-8

<html>
<head>
<style type="text/css">
        body {
            font-family: "Open Sans", Arial, Helvetica, sans-serif;
        }
      .kursInfoHeader {background-color: #bce1ff; font-weight: bold;}
      .signature { font-size: 90%;}
    </style>
    <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet">
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<title>kiBon  – Rejet de l'inscription</title>

</head>

<body>

<div>
	<p>
		Bonjour,
	</p>
	<p>
		Votre inscription pour Simon Wälti / Tagesschule Bern a été rejetée.
		Vous pouvez consulter la liste des offres de prise en charge
		<a href="https://be.kibon.example.com/gesuch/betreuungen/<ID-1>">ici</a>.
	</p>
	<p>
		Nous vous présentons nos meilleures salutations.<br/>
		Commune London
	</p>
	<p>
		Merci de ne pas répondre à ce message automatique.
	</p>
</div>

</body>

</html>

]


