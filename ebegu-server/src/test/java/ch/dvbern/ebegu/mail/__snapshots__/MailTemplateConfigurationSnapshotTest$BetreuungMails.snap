InfoBetreuungGeloescht[BERN_FRANZOESISCH]=[
From: kibon@dvbern.ch
To: Kita Aaregg <empfaenger@dvbern.ch>
Subject: 000042, 2017/2018, Kita Aaregg: kiBon  – Suppression de l'offre de prise en charge
Content-Type: text/html;charset=utf-8

<html>
<head>
<style type="text/css">
        body {
            font-family: "Open Sans", Arial, Helvetica, sans-serif;
        }
      .kursInfoHeader {background-color: #bce1ff; font-weight: bold;}
      .signature { font-size: 90%;}
    </style>
    <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet">
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<title>Kita Aaregg: kiBon  – Suppression de l'offre de prise en charge</title>

</head>

<body>

<div>
	<p>
		Bonjour,
	</p>
	<p>
		La famille a décidé de supprimer l'offre de prise en charge suivante:
	</p>
	<table>
		<tbody>
		<tr>
			<td width="300">Cas:</td>
			<td width="300"><a href="https://be.kibon.example.com/gesuch/betreuungen/<ID-1>">000042 Wälti</a></td>
		</tr>
		<tr>
			<td>Enfant:</td>
			<td>Simon Wälti, 13.04.2014</td>
		</tr>
		<tr>
			<td>Offre de prise en charge:</td>
			<td>Crèche</td>
		</tr>
		<tr>
			<td>Institution:</td>
			<td>Kita Aaregg</td>
		</tr>
		<tr>
			<td>Période:</td>
			<td>2017/2018</td>
		</tr>
		<tr>
			<td>Statut de la prise en charge supprimée:</td>
			<td>Confirmé</td>
		</tr>
		</tbody>
	</table>
	<br/>
	<p>
		Les informations ont été saisies le 05.01.2026.
	</p>
	<p>
		Avec nos salutations les meilleures,<br/>
		kiBon-Team
	</p>
	<p>
		Merci de ne pas répondre à ce message automatique.
	</p>
</div>

</body>

</html>

]


