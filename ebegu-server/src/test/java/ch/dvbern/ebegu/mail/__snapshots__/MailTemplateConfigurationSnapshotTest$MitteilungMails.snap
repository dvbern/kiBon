InfoMitteilungErhalten[APPENZELL_AUSSERRHODEN_DEUTSCH]=[
From: kibon@dvbern.ch
To: Dagmar Wälti <empfaenger@dvbern.ch>
Subject: kiBon  - Neue Nachricht der Gemeinde London
Content-Type: text/html;charset=utf-8

<html>
<head>
<style type="text/css">
        body {
            font-family: "Open Sans", Arial, Helvetica, sans-serif;
        }
      .kursInfoHeader {background-color: #bce1ff; font-weight: bold;}
      .signature { font-size: 90%;}
    </style>
    <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet">
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<title>kiBon  - Neue Nachricht der Gemeinde London</title>

</head>

<body>

<div>
	<p>
		Sehr geehrte Familie
	</p>
	<p>
		Die Gemeinde London hat Ihnen eine
		<a href="https://ar.kibon.example.com/mitteilungen/<ID-1>/<ID-2>/">Nachricht</a>
		geschrieben.
	</p>
	<p>
		Freundliche Grüsse <br/>
		Sozialversicherungen Appenzell Ausserrhoden
	</p>
	<p>
		Dies ist eine automatisch versendete E-Mail. Bitte antworten Sie nicht auf diese Nachricht.
	</p>
</div>

</body>

</html>

]


