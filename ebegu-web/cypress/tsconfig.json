{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "allowJs": true,
        "outDir": "./dist/out-tsc",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "module": "es2020",
        "types": ["cypress", "node"],
        "sourceMap": false
    },
    "include": [
        "**/*.ts",
        "**/*.js",
        "../cypress.config.ts",
        "../**/*.cy.ts",
        "../**/*.cy.tsx",
        "../**/*.cy.js",
        "../**/*.cy.jsx",
        "../**/*.d.ts"
    ]
}
