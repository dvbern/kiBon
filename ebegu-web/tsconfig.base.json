{
    "compileOnSave": false,
    "compilerOptions": {
        "declaration": false,
        "emitDecoratorMetadata": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "lib": ["dom", "es2017", "es2018.promise"],
        "module": "es2022",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "newLine": "lf",
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "noImplicitAny": true,
        "preserveConstEnums": true,
        "outDir": "./dist/out-tsc",
        "pretty": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": false,
        "baseUrl": ".",
        "typeRoots": ["node_modules/@types"],
        "useDefineForClassFields": false,
        "ignoreDeprecations": "6.0",
        "paths": {
            "@dv-e2e/fixtures": ["./cypress/support/fixture-helper.ts"],
            "@dv-e2e/page-objects": ["./cypress/page-objects/index.ts"],
            "@dv-e2e/tasks": ["./cypress/support/tasks.ts"],
            "@dv-e2e/types": ["./cypress/support/types.ts"],
            "@models/constants": ["src/models/constants/CONSTANTS.ts"],
            "@models/meldungsfenster": ["src/models/meldungsfenster/index.ts"],
            "@models/mandant": ["src/models/mandant/index.ts"],
            "@models/zahlung": ["src/models/zahlung/index.ts"],
            "@app/shared/pattern/meldungsfenster": [
                "src/app/shared/pattern/meldungsfenster/index.ts"
            ],
            "@app/shared/pattern/tooltip-x": [
                "src/app/shared/pattern/tooltip-x/index.ts"
            ],
            "@app/shared/component/remove-dialog": [
                "src/app/shared/component/remove-dialog/index.ts"
            ],
            "@app/shared/component/date-time-picker": [
                "src/app/shared/component/date-time-picker"
            ],
            "@app/shared/ui-meldungsfenster": [
                "src/app/shared/ui-meldungsfenster/index.ts"
            ],
            "@app/zahlung/service": [
                "src/app/zahlung/zahlung-service/index.ts"
            ],
            "@app/zahlung/zahlungslauf-erstellen": [
                "src/app/zahlung/zahlungslauf-erstellen/index.ts"
            ],
            "@gesuch/kind/kind-terminiert": [
                "src/gesuch/kind/kind-gueltigkeit-terminiert/index.ts"
            ],
            "@gesuch/mutation/dialog": [
                "src/gesuch/mutation/mutation-dialog/index.ts"
            ],
            "@gesuch/page-layout": ["src/gesuch/page-layout/index.ts"],
            "@gesuch/heading": ["src/gesuch/heading/index.ts"],
            "@gesuch/dokumente": ["src/gesuch/dokumente/index.ts"],
            "@hybrid/gesuch/erwerbspensum": [
                "src/hybrid/gesuch/erwerbspensum/index.ts"
            ],
            "@hybrid/gesuch/betreuung": [
                "src/hybrid/gesuch/betreuung/index.ts"
            ],
            "@admin/util": ["src/admin/util/index.ts"],
            "@admin/gesuchsperioden-einstellungen": [
                "src/admin/gesuchsperioden-einstellungen/index.ts"
            ],
            "@admin/einstellungen": [
                "src/admin/einstellungen/edit-einstellung/index.ts"
            ],
            "@admin/tagesschule-modul-list": [
                "src/admin/tagesschule-modul-list/index.ts"
            ],
            "@utils/log": ["src/utils/log-factory/index.ts"],
            "@utils/moment": ["src/utils/date/index.ts"],
            "@utils/mandant": ["src/utils/mandant-service/index.ts"],
            "@utils/application-property-rs": [
                "src/utils/application-property-rs/index.ts"
            ],
            "@utils/hybrid-form-bridge": [
                "src/utils/hybrid-form-bridge/index.ts"
            ]
        }
    },
    "angularCompilerOptions": {
        "fullTemplateTypeCheck": true,
        "strictInjectionParameters": true
    }
}
