{
    "$schema": "http://json-schema.org/schema",
    "cli": "nx",
    "$id": "Feature",
    "title": "",
    "type": "object",
    "required": ["name"],
    "properties": {
        "name": {
            "type": "string",
            "description": "Feature scope name",
            "$default": {
                "$source": "argv",
                "index": 0
            },
            "x-prompt": "What is the feature scope name (use singular form)?"
        },
        "description": {
            "type": "string",
            "description": "Feature scope description",
            "x-prompt": "What is the feature scope description (used during lib generation, use format [name] - description])?"
        }
    }
}
