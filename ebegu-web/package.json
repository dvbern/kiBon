  "private": true,
  "scripts": {
    "rimraf": "rimraf",
    "typedoc": "typedoc",
    "clean": "rimraf -- doc coverage dist .cache_loader",
    "prebuild": "check-engine && npm run clean && npm run set-version",
    "build": "npm run build:prod",
    "prebuild:ci": "npm run prebuild",
    "build:ci": "npm run build:prod -- --progress=false",
    "build:prod": "nx build --prod",
    "preserver": "check-engine && npm run set-version",
    "server": "nx serve --disable-host-check",
    "prelint": "check-engine",
    "lint": "concurrently 'npm:fmt:check' 'npm:lint:ng' 'npm:lint:tsc' 'npm:lint:style'",
    "lint:ci": "concurrently 'npm:fmt:check' 'npm:lint:ng' 'npm:lint:tsc'",
    "lint:ng": "nx run-many --target=lint",
    "lint:ng:fix": "nx lint --fix",
    "lint:ng:quiet": "nx lint --quiet",
    "lint:style": "stylelint -s less \"**/*.less\"",
    "lint:style:fix": "stylelint --fix -s less \"**/*.less\"",
    "lint:tsc": "tsc --pretty --noEmit --project ./src/tsconfig.app.json && tsc --pretty --noEmit --project ./src/tsconfig.spec.json",
    "pretest": "check-engine",
    "test": "nx run-many --target=test --watch=false --code-coverage --parallel=3",
    "pretest:ci": "npm run pretest",
    "start": "npm run server",
    "set-version": "node scripts/version-from-pom.js",
    "postinstall": "npm run set-version && mkdirp build",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:parallel": "cypress-parallel -s cypress:run -t 3 -d \"cypress/e2e/**/*.cy.ts\"",
    "fmt": "prettier . --write",
    "fmt:check": "prettier . --check",
    "g": "nx generate @dv/tooling/nx-plugin:lib",
    "g:feature": "nx generate @dv/tooling/nx-plugin:feature",
    "g:experimental": "nx generate @kibon/kibon-generator:lib",
    "g:e": "npm run g:experimental"
  },
