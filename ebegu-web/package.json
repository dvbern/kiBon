  "scripts": {
    "rimraf": "rimraf",
    "typedoc": "typedoc",
    "clean": "rimraf -- doc coverage dist .cache_loader",
    "prebuild": "npm run clean && npm run set-version",
    "build": "npm run build:prod",
    "prebuild:ci": "npm run prebuild",
    "build:ci": "npm run build:prod -c production --progress=false",
    "build:prod": "ng build -c production --progress=false",
    "preserver": "npm run set-version",
    "server": "ng serve ebegu --disable-host-check",
    "lint": "concurrently 'npm:fmt:check' 'npm:lint:ng' 'npm:lint:tsc'",
    "lint:ci": "concurrently 'npm:fmt:check' 'npm:lint:ng' 'npm:lint:tsc'",
    "lint:ng": "ng lint",
    "lint:ng:fix": "ng lint --fix",
    "lint:ng:quiet": "ng lint --quiet",
    "lint:tsc": "tsc --pretty --noEmit --project tsconfig.app.json && tsc --pretty --noEmit --project ./src/tsconfig.spec.json",
    "test": "ng test --watch=false --code-coverage",
    "start": "npm run server",
    "set-version": "node scripts/version-from-pom.js",
    "postinstall": "npm run set-version && mkdirp build && patch-package",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:parallel": "cypress-parallel -s cypress:run -t 3 -d \"cypress/e2e/**/*.cy.ts\"",
    "fmt": "prettier . --write",
    "fmt:check": "prettier . --check"
  },
