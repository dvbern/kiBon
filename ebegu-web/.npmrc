git-tag-version = false
registry = https://nexus.dvbern.ch/nexus/content/groups/npm-all/
engine-strict=true

# Some dependencies (e.g. @uirouter/angular, @uirouter/angular-hybrid) have not published
# a release with Angular 22 peer ranges yet. Without this flag neither `npm install` nor
# `npm ci` can resolve the tree. Remove it once all deps declare Angular 22 support.
legacy-peer-deps=true
